[Unit]
Description=Belfry Clockwork — Scheduler that fires due reminders
After=network.target

[Service]
Type=simple
User=belfry
Group=belfry
WorkingDirectory=/srv/belfry
EnvironmentFile=/srv/belfry/.env
ExecStart=/usr/bin/uv run clockwork.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
